# AI providers — which provider does what lives in src/config/aiConfig.ts
# Text (Fireworks)
FIREWORKS_API_KEY=fw_your-fireworks-key
# Images (fal.ai)
FAL_KEY=your-fal-key
# Audio: TTS + transcription (OpenAI)
OPENAI_API_KEY=sk-your-openai-key

#MONGO
MONGO_URL=mongodb://user:pass@localhost:27017/yourdb?authSource=admin

#INITIAL SETUP
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
USER_NOVA=your_admin_user
PASSWORD_NOVA=your_admin_password
JWT_SECRET=your-jwt-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
LABS_AUTH=false

#CLOUDINARY
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gmail Configuration for Backup Service
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-app-password
GMAIL_FROM_NAME=LanguageAI Backup System

# Backup Email Configuration
BACKUP_EMAIL_ENABLED=true
BACKUP_EMAIL_RECIPIENT=your-gmail@gmail.com
BACKUP_CRON_SCHEDULE=0 30 23 * * *
BACKUP_TIMEZONE=America/Bogota

#POCKETBASE
POCKETBASE_URL=URLAPIPOCKETBASEHERE
POCKETBASE_ADMIN_EMAIL=your-pocketbase-admin-email
POCKETBASE_ADMIN_PASSWORD=your-pocketbase-admin-password
