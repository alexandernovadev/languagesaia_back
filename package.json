  "scripts": {
    "build": "rm -rf ./dist && tsc && mv dist/src/* dist/ && rm -rf dist/src && cp -r public dist/public && node scripts/build-date.js",
    "build:dev": "node scripts/build-date.js && rm -rf ./dist && tsc && mv dist/src/* dist/ && rm -rf dist/src && cp -r public dist/public",
    "start": "node dist/main.js",
    "dev": "pnpm clean:logs && tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "clean:logs": "node scripts/clean-logs.js",
    "seed:dictionary": "tsx scripts/seed-dictionary.ts"
  },
